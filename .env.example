# Neon connection string: Neon console → your project → Connect.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth: signs sessions. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me
# Public origin of the app (defaults to http://localhost:PORT).
# BETTER_AUTH_URL=https://your-app.example.com
